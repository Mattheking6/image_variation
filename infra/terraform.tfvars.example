# Copy to terraform.tfvars and adjust.
# Credentials can also come from SCW_ACCESS_KEY / SCW_SECRET_KEY env vars
# or the Scaleway configuration file (~/.scaleway/config).

project_id    = "<YOUR-PROJECT-ID>"
region        = "fr-par"
bucket_name   = "image-variation-site"
pipeline_name = "image-variation"

# Custom domain, or "" for the default <pipeline-id>.svc.edge.scw.cloud endpoint.
# For a Scaleway-registered domain the Edge Services pipeline manages the
# CNAME (name it in the console / set it here); for an external domain create
# a CNAME yourself pointing to the edge_endpoint output.
domain = ""

edge_services_plan = "starter"
